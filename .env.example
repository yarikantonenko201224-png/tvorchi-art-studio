# Шаблон переменных окружения. Копируется в .env.local для локальной разработки,
# а на проде значения задаются в Vercel → Settings → Environment Variables.
#
# ВАЖНО: .env.local в .gitignore и в репозиторий не попадает.
# Никогда не вписывайте реальные ключи в этот файл — он публичный.

# Анонсы: ссылка на опубликованную Google-таблицу в формате CSV.
# Пока не задана, сайт показывает демо-события из lib/announcements.ts
ANNOUNCEMENTS_CSV_URL=

# База данных. Пока не заданы — заявки пишутся только в логи сервера,
# а админка честно сообщает, что БД не подключена. Инструкция: docs/SUPABASE.md
# ВНИМАНИЕ: service_role обходит все ограничения доступа. Только сервер, только Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Пароль для входа в /admin. Длинный и не такой, как от других сервисов.
ADMIN_PASSWORD=

# Уведомления администратору о новых заявках (появится на следующем шаге).
# Токен берётся у @BotFather, chat_id — id чата или группы студии.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
